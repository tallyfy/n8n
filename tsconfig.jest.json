{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"types": ["jest", "node"]
	},
	// `exclude` is NOT inherited harmlessly here, it has to be overridden. The base tsconfig
	// excludes "test", "**/*.spec.ts" and "**/*.test.ts", and exclude beats include, so without
	// this override the "test/**/*.ts" entry below was dead: `tsc -p tsconfig.jest.json` checked
	// exactly 3 files (the two nodes and the credential) and reported success while never looking
	// at a single test file. Measured 2026-08-29 with `--listFilesOnly`; the same command now
	// lists 11, and .github/workflows/ci.yml asserts that count so this cannot silently regress.
	//
	// This does not change what `npm test` compiles. ts-jest picks its file set from jest.config.js
	// roots and testMatch, never from include/exclude here, and only reads the compilerOptions.
	"exclude": [
		"node_modules",
		"dist"
	],
	"include": [
		"credentials/**/*.ts",
		"nodes/**/*.ts",
		"test/**/*.ts"
	]
}
