{
  "name": "n8n-nodes-tallyfy",
  "version": "1.4.1",
  "description": "Complete n8n integration for Tallyfy with 60+ operations across blueprints, processes, tasks, forms, comments, users, groups, and search. See https://tallyfy.com/products/pro/integrations/middleware/n8n/ for complete documentation.",
  "keywords": [
    "n8n",
    "n8n-node",
    "n8n-community-node-package",
    "tallyfy",
    "workflow",
    "automation",
    "process",
    "bpm",
    "task",
    "checklist"
  ],
  "license": "MIT",
  "homepage": "https://github.com/tallyfy/n8n#readme",
  "author": {
    "name": "Tallyfy",
    "email": "support@tallyfy.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tallyfy/n8n.git"
  },
  "bugs": {
    "url": "https://github.com/tallyfy/n8n/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "scripts/check-tsconfig-includes.sh && n8n-node build && scripts/check-icons.sh",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "prepublishOnly": "npm run build && scripts/check-pack-contents.sh",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TallyfyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Tallyfy/Tallyfy.node.js",
      "dist/nodes/TallyfyTrigger/TallyfyTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.52.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "n8n-workflow": "~2.43.5",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
